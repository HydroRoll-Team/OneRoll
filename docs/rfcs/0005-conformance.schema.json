{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneroll.hydroroll.team/schemas/conformance-corpus-1.json",
  "title": "OneRoll conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "result_schema_version", "cases"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "language": {
      "const": "oneroll-v2"
    },
    "result_schema_version": {
      "const": "2.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "tracking_issue",
        "features",
        "source",
        "request",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "status": {
          "enum": ["planned", "required", "legacy"]
        },
        "tracking_issue": {
          "type": "string",
          "pattern": "^#[0-9]+$"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "program",
              "instruction",
              "typed_value",
              "dice_source",
              "validator",
              "option",
              "function",
              "error"
            ]
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expect": {
          "oneOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_mode", "variables", "seed"],
      "properties": {
        "compatibility_mode": {
          "enum": ["strict_v2", "v1"]
        },
        "variables": {
          "type": "object"
        },
        "seed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "canonical",
        "parse",
        "value",
        "scalar",
        "trace",
        "random"
      ],
      "properties": {
        "outcome": {
          "const": "success"
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "parse": {
          "$ref": "#/$defs/parse"
        },
        "value": {
          "$ref": "https://oneroll.hydroroll.team/schema/result-2.0.json#/$defs/Value"
        },
        "scalar": {
          "type": ["integer", "null"]
        },
        "trace": {
          "$ref": "#/$defs/trace_summary"
        },
        "random": {
          "$ref": "#/$defs/random_summary"
        }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_count", "node_kinds"],
      "properties": {
        "instruction_count": {
          "type": "integer",
          "minimum": 1
        },
        "node_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trace_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_kind", "kinds"],
      "properties": {
        "root_kind": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "random_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "rng_words"],
      "properties": {
        "algorithm": {
          "type": ["string", "null"]
        },
        "seed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "rng_words": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "phase", "code", "span", "random_words"],
      "properties": {
        "outcome": {
          "const": "error"
        },
        "phase": {
          "enum": ["input", "parse", "validation", "evaluation", "serialization"]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "random_words": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte"],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
