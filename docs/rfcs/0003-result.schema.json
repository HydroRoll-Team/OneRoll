{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneroll.hydroroll.team/schema/result-2.0.json",
  "title": "OneRoll 2.0 result and error envelope",
  "oneOf": [
    { "$ref": "#/$defs/ProgramResult" },
    { "$ref": "#/$defs/BatchResult" },
    { "$ref": "#/$defs/ErrorEnvelope" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[itr][0-9]+$"
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte"],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 }
      }
    },
    "ScalarValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "scalar" },
        "value": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "TextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "text" },
        "value": { "type": "string" }
      }
    },
    "BooleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      }
    },
    "ValuesValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "values" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/Value" }
        }
      }
    },
    "RollReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "annotations"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^r[0-9]+$" },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "RollSetValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_kind", "items"],
      "properties": {
        "kind": { "const": "roll_set" },
        "item_kind": { "enum": ["scalar", "text"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/RollReference" }
        }
      }
    },
    "Value": {
      "oneOf": [
        { "$ref": "#/$defs/ScalarValue" },
        { "$ref": "#/$defs/TextValue" },
        { "$ref": "#/$defs/BooleanValue" },
        { "$ref": "#/$defs/ValuesValue" },
        { "$ref": "#/$defs/RollSetValue" }
      ]
    },
    "NestedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "label", "instructions"],
      "properties": {
        "kind": {
          "enum": ["repeat_iteration", "branch", "function_call"]
        },
        "index": { "type": "integer", "minimum": 0 },
        "label": { "type": ["string", "null"] },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/InstructionResult" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "branch" } } },
          "then": { "properties": { "label": { "enum": ["true", "false"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "repeat_iteration" } } },
          "then": { "properties": { "label": { "type": "null" } } }
        }
      ]
    },
    "InstructionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "span",
        "canonical",
        "value",
        "scalar",
        "trace_root",
        "executions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^i[0-9]+$" },
        "index": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/Span" },
        "canonical": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/Value" },
        "scalar": {
          "type": ["integer", "null"],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "trace_root": { "type": "string", "pattern": "^t[0-9]+$" },
        "executions": {
          "type": "array",
          "items": { "$ref": "#/$defs/NestedExecution" }
        }
      }
    },
    "RollSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instruction_id",
        "source_index",
        "draw_index",
        "generation",
        "span"
      ],
      "properties": {
        "kind": { "enum": ["numeric_die", "range_die", "list_die"] },
        "instruction_id": { "type": "string", "pattern": "^i[0-9]+$" },
        "source_index": { "type": "integer", "minimum": 0 },
        "draw_index": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/Span" }
      }
    },
    "RollNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "source",
        "parent_node_id",
        "cause_trace_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^r[0-9]+$" },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/ScalarValue" },
            { "$ref": "#/$defs/TextValue" }
          ]
        },
        "source": { "$ref": "#/$defs/RollSource" },
        "parent_node_id": {
          "oneOf": [
            { "type": "string", "pattern": "^r[0-9]+$" },
            { "type": "null" }
          ]
        },
        "cause_trace_id": { "type": "string", "pattern": "^t[0-9]+$" }
      }
    },
    "TraceAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "key", "value"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^r[0-9]+$" },
        "key": { "const": "color" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "TraceData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "selected_roll_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^r[0-9]+$" },
          "uniqueItems": true
        },
        "discarded_roll_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^r[0-9]+$" },
          "uniqueItems": true
        },
        "generated_roll_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^r[0-9]+$" },
          "uniqueItems": true
        },
        "source_instruction_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^i[0-9]+$" },
          "uniqueItems": true
        },
        "branch": { "enum": ["true", "false"] },
        "iteration": { "type": "integer", "minimum": 0 },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/TraceAnnotation" }
        }
      }
    },
    "TraceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "span",
        "inputs",
        "value",
        "related_roll_ids",
        "data"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^t[0-9]+$" },
        "kind": {
          "enum": [
            "literal",
            "variable",
            "source",
            "arithmetic",
            "select",
            "filter",
            "sort",
            "count",
            "reroll",
            "explode",
            "merge",
            "bind",
            "occurrences",
            "paint",
            "split",
            "group",
            "function",
            "branch",
            "projection"
          ]
        },
        "span": {
          "oneOf": [
            { "$ref": "#/$defs/Span" },
            { "type": "null" }
          ]
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^t[0-9]+$" },
          "uniqueItems": true
        },
        "value": { "$ref": "#/$defs/Value" },
        "related_roll_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^r[0-9]+$" },
          "uniqueItems": true
        },
        "data": { "$ref": "#/$defs/TraceData" }
      }
    },
    "RandomDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "rng_words"],
      "properties": {
        "algorithm": { "const": "oneroll-chacha12-v1" },
        "seed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rng_words": { "type": "integer", "minimum": 0 }
      }
    },
    "BatchRandomDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "samples"],
      "properties": {
        "algorithm": { "const": "oneroll-sha256-batch-v1" },
        "seed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "samples": { "type": "integer", "minimum": 1 }
      }
    },
    "BatchFailureDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "samples", "sample_index"],
      "properties": {
        "algorithm": { "const": "oneroll-sha256-batch-v1" },
        "seed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "samples": { "type": "integer", "minimum": 1 },
        "sample_index": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "message"],
      "properties": {
        "phase": { "enum": ["parse", "validate", "evaluate", "cancel"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "message": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/Span" },
        "replacement": { "type": "string", "minLength": 1 }
      }
    },
    "ResultMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_mode", "random", "warnings"],
      "properties": {
        "compatibility_mode": { "enum": ["strict_v2", "v1"] },
        "random": { "$ref": "#/$defs/RandomDescriptor" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "ProgramResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source",
        "canonical",
        "comment",
        "instructions",
        "roll_nodes",
        "trace_nodes",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "kind": { "const": "program_result" },
        "source": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string", "minLength": 1 },
        "comment": { "type": ["string", "null"] },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/InstructionResult" }
        },
        "roll_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/RollNode" }
        },
        "trace_nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TraceNode" }
        },
        "metadata": { "$ref": "#/$defs/ResultMetadata" }
      }
    },
    "BatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source",
        "canonical",
        "results",
        "random"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "kind": { "const": "batch_result" },
        "source": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string", "minLength": 1 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ProgramResult" }
        },
        "random": { "$ref": "#/$defs/BatchRandomDescriptor" }
      }
    },
    "ExecutionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "message"],
      "properties": {
        "phase": { "enum": ["parse", "validate", "evaluate", "cancel"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "message": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/Span" },
        "resource": { "type": "string", "minLength": 1 },
        "used": { "type": "integer", "minimum": 0 },
        "requested": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 },
        "random": { "$ref": "#/$defs/RandomDescriptor" },
        "batch": { "$ref": "#/$defs/BatchFailureDescriptor" },
        "expected": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "replacement": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["resource"] },
          "then": { "required": ["used", "requested", "limit"] }
        },
        {
          "if": { "properties": { "code": { "pattern": "^limit\\." } } },
          "then": {
            "required": ["resource", "used", "requested", "limit"]
          }
        }
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "error"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "kind": { "const": "error" },
        "error": { "$ref": "#/$defs/ExecutionError" }
      }
    }
  }
}
