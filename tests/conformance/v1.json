    {
      "id": "integer_literal",
      "expression": "7",
      "classification": "intended",
      "note": "Integer literals evaluate without generating dice values.",
      "expect": {
        "status": "success",
        "total": 7,
        "flattened_rolls": 0,
        "comment": ""
      }
    },
    {
      "id": "negative_integer_literal",
      "expression": "-2",
      "classification": "intended",
      "note": "Signed integer literals evaluate without generating dice values.",
