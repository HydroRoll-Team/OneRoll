        "status": "error",
        "message_contains": "[arithmetic.overflow]"
      }
    },
    {
      "id": "division_overflow",
      "expression": "-9223372036854775808 / -1",
      "classification": "intended",
      "note": "The signed division overflow edge returns a stable error.",
      "expect": {
        "status": "error",
        "message_contains": "[arithmetic.overflow]"
      }
